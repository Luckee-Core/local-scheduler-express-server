# Default 3022 matches Luckee Hub projects.registry defaultApiPort (use 4120 only if you prefer README legacy port)
PORT=3022
# macOS Homebrew: role is usually your login name. setup-studio-db.sh fixes placeholders automatically.
# DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/local_scheduler
SCHEDULER_WORKERS_DIR=/tmp/local-scheduler/workers

# Philly AI Consulting — POST /api/cron/process-lead-contact-email-queue
# PHILLY_AI_CONSULTING_CRON_SECRET=

# Gmail Manager job routes (tasks with authEnvKey GMAIL_MANAGER_CRON_SECRET)
# GMAIL_MANAGER_CRON_SECRET=

# City Nonprofits — POST /api/newsletter/digest/* (production Railway; must match city-nonprofits-express-server)
# CITY_NONPROFITS_CRON_SECRET=
